<xml xmlns="http://www.w3.org/1999/xhtml" collection="false">
  <variables>
    <variable type="" id="var_initial_stake">INITIAL_STAKE</variable>
    <variable type="" id="var_stake">STAKE</variable>
    <variable type="" id="var_take_profit">TAKE_PROFIT</variable>
    <variable type="" id="var_stop_loss">STOP_LOSS</variable>
    <variable type="" id="var_martingale">MARTINGALE</variable>
    <variable type="" id="var_ticks_to_analyse">TICKS_TO_ANALYSE</variable>
    <variable type="" id="var_loss_count">LOSS_COUNT</variable>
    <variable type="" id="var_mode">MODE</variable>
    <variable type="" id="var_alt_flag">ALT_FLAG</variable>
    <variable type="" id="var_current_contract">CURRENT_CONTRACT</variable>
    <variable type="" id="var_digit_list">DIGIT_LIST</variable>
    <variable type="" id="var_even_count">EVEN_COUNT</variable>
    <variable type="" id="var_odd_count">ODD_COUNT</variable>
    <variable type="" id="var_pct_even">PCT_EVEN</variable>
    <variable type="" id="var_pct_odd">PCT_ODD</variable>
    <variable type="" id="var_i">i</variable>
  </variables>

  <!-- BLOCK 1: Trade Parameters -->

  <block type="trade_definition" id="trade_def_root" x="0" y="60">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="tdm1">
        <field name="MARKET_LIST">synthetic_index</field>
        <field name="SUBMARKET_LIST">random_index</field>
        <field name="SYMBOL_LIST">1HZ50V</field>
        <next>
          <block type="trade_definition_tradetype" id="tdt1">
            <field name="TRADETYPECAT_LIST">digits</field>
            <field name="TRADETYPE_LIST">evenodd</field>
            <next>
              <block type="trade_definition_contracttype" id="tdc1">
                <field name="TYPE_LIST">both</field>
                <next>
                  <block type="trade_definition_candleinterval" id="tdci1">
                    <field name="CANDLEINTERVAL_LIST">60</field>
                    <next>
                      <block type="trade_definition_restartbuysell" id="tdrb1">
                        <field name="TIME_MACHINE_ENABLED">FALSE</field>
                        <next>
                          <block type="trade_definition_restartonerror" id="tdroe1">
                            <field name="RESTARTONERROR">TRUE</field>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="init_initial_stake">
        <field name="VAR" id="var_initial_stake">INITIAL_STAKE</field>
        <value name="VALUE">
          <block type="math_number" id="num_init_stake">
            <field name="NUM">0.7</field>
          </block>
        </value>
        <next>
          <block type="variables_set" id="init_stake">
            <field name="VAR" id="var_stake">STAKE</field>
            <value name="VALUE">
              <block type="variables_get" id="get_init_stake_val">
                <field name="VAR" id="var_initial_stake">INITIAL_STAKE</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="init_tp">
                <field name="VAR" id="var_take_profit">TAKE_PROFIT</field>
                <value name="VALUE">
                  <block type="math_number" id="num_tp">
                    <field name="NUM">3</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="init_sl">
                    <field name="VAR" id="var_stop_loss">STOP_LOSS</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_sl">
                        <field name="NUM">15</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="init_martingale">
                        <field name="VAR" id="var_martingale">MARTINGALE</field>
                        <value name="VALUE">
                          <block type="math_number" id="num_martingale">
                            <field name="NUM">2.1</field>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="init_ticks_analyse">
                            <field name="VAR" id="var_ticks_to_analyse">TICKS_TO_ANALYSE</field>
                            <value name="VALUE">
                              <block type="math_number" id="num_ticks">
                                <field name="NUM">200</field>
                              </block>
                            </value>
                            <next>
                              <block type="variables_set" id="init_loss_count">
                                <field name="VAR" id="var_loss_count">LOSS_COUNT</field>
                                <value name="VALUE">
                                  <block type="math_number" id="num_loss_zero">
                                    <field name="NUM">0</field>
                                  </block>
                                </value>
                                <next>
                                  <block type="variables_set" id="init_mode">
                                    <field name="VAR" id="var_mode">MODE</field>
                                    <value name="VALUE">
                                      <block type="math_number" id="num_mode_zero">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                    <next>
                                      <block type="variables_set" id="init_alt_flag">
                                        <field name="VAR" id="var_alt_flag">ALT_FLAG</field>
                                        <value name="VALUE">
                                          <block type="math_number" id="num_alt_zero">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="init_contract">
                                            <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                            <value name="VALUE">
                                              <block type="text" id="txt_initial_contract">
                                                <field name="TEXT">DIGITEVEN</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </next>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
    <statement name="SUBMARKET">
      <block type="trade_definition_tradeoptions" id="tdto1">
        <mutation has_first_barrier="false" has_second_barrier="false" has_prediction="false"></mutation>
        <field name="DURATIONTYPE_LIST">t</field>
        <value name="DURATION">
          <shadow type="math_number" id="dur_num">
            <field name="NUM">1</field>
          </shadow>
        </value>
        <value name="AMOUNT">
          <shadow type="math_number" id="amt_num">
            <field name="NUM">1</field>
          </shadow>
          <block type="variables_get" id="get_stake_val">
            <field name="VAR" id="var_stake">STAKE</field>
          </block>
        </value>
      </block>
    </statement>
  </block>

  <!-- BLOCK 2: Purchase Conditions -->

  <block type="before_purchase" id="before_purchase_root" x="0" y="1120">
    <statement name="BEFOREPURCHASE_STACK">
      <block type="variables_set" id="set_digits_list">
        <field name="VAR" id="var_digit_list">DIGIT_LIST</field>
        <value name="VALUE">
          <block type="last_digit_list" id="ldl1"></block>
        </value>
        <next>
          <block type="variables_set" id="reset_even_count">
            <field name="VAR" id="var_even_count">EVEN_COUNT</field>
            <value name="VALUE">
              <block type="math_number" id="num_e_zero">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_odd_count">
                <field name="VAR" id="var_odd_count">ODD_COUNT</field>
                <value name="VALUE">
                  <block type="math_number" id="num_o_zero">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="controls_forEach" id="loop_digits">
                    <field name="VAR" id="var_i">i</field>
                    <value name="LIST">
                      <block type="variables_get" id="get_dl_loop">
                        <field name="VAR" id="var_digit_list">DIGIT_LIST</field>
                      </block>
                    </value>
                    <statement name="DO">
                      <block type="controls_if" id="if_even_odd">
                        <mutation else="1"></mutation>
                        <value name="IF0">
                          <block type="logic_compare" id="cmp_mod2">
                            <field name="OP">EQ</field>
                            <value name="A">
                              <block type="math_modulo" id="calc_mod2">
                                <value name="DIVIDEND">
                                  <block type="variables_get" id="get_i">
                                    <field name="VAR" id="var_i">i</field>
                                  </block>
                                </value>
                                <value name="DIVISOR">
                                  <shadow type="math_number" id="num_div2">
                                    <field name="NUM">2</field>
                                  </shadow>
                                </value>
                              </block>
                            </value>
                            <value name="B">
                              <block type="math_number" id="num_zero_mod">
                                <field name="NUM">0</field>
                              </block>
                            </value>
                          </block>
                        </value>
                        <statement name="DO0">
                          <block type="math_change" id="inc_even">
                            <field name="VAR" id="var_even_count">EVEN_COUNT</field>
                            <value name="DELTA">
                              <shadow type="math_number" id="delta_e">
                                <field name="NUM">1</field>
                              </shadow>
                            </value>
                          </block>
                        </statement>
                        <statement name="ELSE">
                          <block type="math_change" id="inc_odd">
                            <field name="VAR" id="var_odd_count">ODD_COUNT</field>
                            <value name="DELTA">
                              <shadow type="math_number" id="delta_o">
                                <field name="NUM">1</field>
                              </shadow>
                            </value>
                          </block>
                        </statement>
                      </block>
                    </statement>
                    <next>
                      <block type="variables_set" id="calc_pct_even">
                        <field name="VAR" id="var_pct_even">PCT_EVEN</field>
                        <value name="VALUE">
                          <block type="math_arithmetic" id="div_even_total">
                            <field name="OP">DIVIDE</field>
                            <value name="A">
                              <block type="variables_get" id="get_ec_val">
                                <field name="VAR" id="var_even_count">EVEN_COUNT</field>
                              </block>
                            </value>
                            <value name="B">
                              <block type="lists_length" id="len_dl_e">
                                <value name="VALUE">
                                  <block type="variables_get" id="get_dl_len_e">
                                    <field name="VAR" id="var_digit_list">DIGIT_LIST</field>
                                  </block>
                                </value>
                              </block>
                            </value>
                          </block>
                        </value>
                        <next>
                          <block type="variables_set" id="calc_pct_odd">
                            <field name="VAR" id="var_pct_odd">PCT_ODD</field>
                            <value name="VALUE">
                              <block type="math_arithmetic" id="div_odd_total">
                                <field name="OP">DIVIDE</field>
                                <value name="A">
                                  <block type="variables_get" id="get_oc_val">
                                    <field name="VAR" id="var_odd_count">ODD_COUNT</field>
                                  </block>
                                </value>
                                <value name="B">
                                  <block type="lists_length" id="len_dl_o">
                                    <value name="VALUE">
                                      <block type="variables_get" id="get_dl_len_o">
                                        <field name="VAR" id="var_digit_list">DIGIT_LIST</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                              </block>
                            </value>
                            <next>
                              <block type="controls_if" id="check_mode">
                                <mutation elseif="1" else="1"></mutation>
                                <!-- IF MODE == 1 (Strict Alternation) -->
                                <value name="IF0">
                                  <block type="logic_compare" id="cmp_m1">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get" id="get_m_val">
                                        <field name="VAR" id="var_mode">MODE</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number" id="num_m1">
                                        <field name="NUM">1</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO0">
                                  <block type="controls_if" id="check_alt_flag">
                                    <mutation else="1"></mutation>
                                    <value name="IF0">
                                      <block type="logic_compare" id="cmp_af0">
                                        <field name="OP">EQ</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_af_val">
                                            <field name="VAR" id="var_alt_flag">ALT_FLAG</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="math_number" id="num_af0">
                                            <field name="NUM">0</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="variables_set" id="set_alt_even">
                                        <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                        <value name="VALUE">
                                          <block type="text" id="txt_alt_e">
                                            <field name="TEXT">DIGITEVEN</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="toggle_af1">
                                            <field name="VAR" id="var_alt_flag">ALT_FLAG</field>
                                            <value name="VALUE">
                                              <block type="math_number" id="num_af1">
                                                <field name="NUM">1</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                    <statement name="ELSE">
                                      <block type="variables_set" id="set_alt_odd">
                                        <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                        <value name="VALUE">
                                          <block type="text" id="txt_alt_o">
                                            <field name="TEXT">DIGITODD</field>
                                          </block>
                                        </value>
                                        <next>
                                          <block type="variables_set" id="toggle_af0">
                                            <field name="VAR" id="var_alt_flag">ALT_FLAG</field>
                                            <value name="VALUE">
                                              <block type="math_number" id="num_af_rst">
                                                <field name="NUM">0</field>
                                              </block>
                                            </value>
                                          </block>
                                        </next>
                                      </block>
                                    </statement>
                                  </block>
                                </statement>
                                <!-- ELSE IF LOSS_COUNT == 0 (Pick Higher Frequency) -->
                                <value name="IF1">
                                  <block type="logic_compare" id="cmp_lc0">
                                    <field name="OP">EQ</field>
                                    <value name="A">
                                      <block type="variables_get" id="get_lc_val">
                                        <field name="VAR" id="var_loss_count">LOSS_COUNT</field>
                                      </block>
                                    </value>
                                    <value name="B">
                                      <block type="math_number" id="num_lc0">
                                        <field name="NUM">0</field>
                                      </block>
                                    </value>
                                  </block>
                                </value>
                                <statement name="DO1">
                                  <block type="controls_if" id="compare_percentages">
                                    <mutation else="1"></mutation>
                                    <value name="IF0">
                                      <block type="logic_compare" id="cmp_pe_gte_po">
                                        <field name="OP">GTE</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_pe_val">
                                            <field name="VAR" id="var_pct_even">PCT_EVEN</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="variables_get" id="get_po_val">
                                            <field name="VAR" id="var_pct_odd">PCT_ODD</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="variables_set" id="set_freq_even">
                                        <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                        <value name="VALUE">
                                          <block type="text" id="txt_freq_e">
                                            <field name="TEXT">DIGITEVEN</field>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                    <statement name="ELSE">
                                      <block type="variables_set" id="set_freq_odd">
                                        <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                        <value name="VALUE">
                                          <block type="text" id="txt_freq_o">
                                            <field name="TEXT">DIGITODD</field>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                  </block>
                                </statement>
                                <!-- ELSE (1-2 Losses: Invert Previous Contract) -->
                                <statement name="ELSE">
                                  <block type="controls_if" id="invert_contract">
                                    <mutation else="1"></mutation>
                                    <value name="IF0">
                                      <block type="logic_compare" id="cmp_prev_even">
                                        <field name="OP">EQ</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_curr_val">
                                            <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="text" id="txt_is_even">
                                            <field name="TEXT">DIGITEVEN</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="variables_set" id="flip_to_odd">
                                        <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                        <value name="VALUE">
                                          <block type="text" id="txt_inv_o">
                                            <field name="TEXT">DIGITODD</field>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                    <statement name="ELSE">
                                      <block type="variables_set" id="flip_to_even">
                                        <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                        <value name="VALUE">
                                          <block type="text" id="txt_inv_e">
                                            <field name="TEXT">DIGITEVEN</field>
                                          </block>
                                        </value>
                                      </block>
                                    </statement>
                                  </block>
                                </statement>
                                <next>
                                  <!-- Execute Purchase Decision -->
                                  <block type="controls_if" id="purchase_contract">
                                    <mutation else="1"></mutation>
                                    <value name="IF0">
                                      <block type="logic_compare" id="check_is_even_pur">
                                        <field name="OP">EQ</field>
                                        <value name="A">
                                          <block type="variables_get" id="get_pur_contract">
                                            <field name="VAR" id="var_current_contract">CURRENT_CONTRACT</field>
                                          </block>
                                        </value>
                                        <value name="B">
                                          <block type="text" id="txt_pur_even">
                                            <field name="TEXT">DIGITEVEN</field>
                                          </block>
                                        </value>
                                      </block>
                                    </value>
                                    <statement name="DO0">
                                      <block type="purchase" id="buy_even">
                                        <field name="PURCHASE_LIST">DIGITEVEN</field>
                                      </block>
                                    </statement>
                                    <statement name="ELSE">
                                      <block type="purchase" id="buy_odd">
                                        <field name="PURCHASE_LIST">DIGITODD</field>
                                      </block>
                                    </statement>
                                  </block>
                                </next>
                              </block>
                            </next>
                          </block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- BLOCK 4: Restart Trading Conditions -->

  <block type="after_purchase" id="after_purchase_root" x="736" y="60">
    <statement name="AFTERPURCHASE_STACK">
      <block type="controls_if" id="check_trade_targets">
        <mutation elseif="2" else="1"></mutation>
        <!-- IF Total Profit >= TAKE_PROFIT -->
        <value name="IF0">
          <block type="logic_compare" id="cmp_tp">
            <field name="OP">GTE</field>
            <value name="A">
              <block type="total_profit" id="tp_val_1"></block>
            </value>
            <value name="B">
              <block type="variables_get" id="get_tp_target">
                <field name="VAR" id="var_take_profit">TAKE_PROFIT</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="text_print" id="print_tp">
            <value name="TEXT">
              <shadow type="text" id="txt_tp_stop">
                <field name="TEXT">Take profit reached. Stopping.</field>
              </shadow>
            </value>
          </block>
        </statement>
        <!-- ELSE IF Total Profit <= -STOP_LOSS -->
        <value name="IF1">
          <block type="logic_compare" id="cmp_sl">
            <field name="OP">LTE</field>
            <value name="A">
              <block type="total_profit" id="tp_val_2"></block>
            </value>
            <value name="B">
              <block type="math_single" id="neg_sl">
                <field name="OP">NEG</field>
                <value name="NUM">
                  <shadow type="math_number" id="num_neg_sl">
                    <field name="NUM">9</field>
                  </shadow>
                  <block type="variables_get" id="get_sl_target">
                    <field name="VAR" id="var_stop_loss">STOP_LOSS</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO1">
          <block type="text_print" id="print_sl">
            <value name="TEXT">
              <shadow type="text" id="txt_sl_stop">
                <field name="TEXT">Stop loss hit.</field>
              </shadow>
            </value>
          </block>
        </statement>
        <!-- ELSE IF Win -->
        <value name="IF2">
          <block type="contract_check_result" id="check_win">
            <field name="CHECK_RESULT">win</field>
          </block>
        </value>
        <statement name="DO2">
          <block type="variables_set" id="reset_loss_win">
            <field name="VAR" id="var_loss_count">LOSS_COUNT</field>
            <value name="VALUE">
              <block type="math_number" id="num_zero_lc">
                <field name="NUM">0</field>
              </block>
            </value>
            <next>
              <block type="variables_set" id="reset_mode_win">
                <field name="VAR" id="var_mode">MODE</field>
                <value name="VALUE">
                  <block type="math_number" id="num_zero_m">
                    <field name="NUM">0</field>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="reset_alt_win">
                    <field name="VAR" id="var_alt_flag">ALT_FLAG</field>
                    <value name="VALUE">
                      <block type="math_number" id="num_zero_af">
                        <field name="NUM">0</field>
                      </block>
                    </value>
                    <next>
                      <block type="variables_set" id="reset_stake_win">
                        <field name="VAR" id="var_stake">STAKE</field>
                        <value name="VALUE">
                          <block type="variables_get" id="get_base_stake">
                            <field name="VAR" id="var_initial_stake">INITIAL_STAKE</field>
                          </block>
                        </value>
                        <next>
                          <block type="trade_again" id="ta_win"></block>
                        </next>
                      </block>
                    </next>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </statement>
        <!-- ELSE (Loss Recovery Branch) -->
        <statement name="ELSE">
          <block type="math_change" id="inc_loss_count">
            <field name="VAR" id="var_loss_count">LOSS_COUNT</field>
            <value name="DELTA">
              <shadow type="math_number" id="delta_lc">
                <field name="NUM">1</field>
              </shadow>
            </value>
            <next>
              <block type="variables_set" id="scale_martingale">
                <field name="VAR" id="var_stake">STAKE</field>
                <value name="VALUE">
                  <block type="math_arithmetic" id="mult_martingale">
                    <field name="OP">MULTIPLY</field>
                    <value name="A">
                      <block type="variables_get" id="get_curr_stake">
                        <field name="VAR" id="var_stake">STAKE</field>
                      </block>
                    </value>
                    <value name="B">
